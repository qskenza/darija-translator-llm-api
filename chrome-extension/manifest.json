{
  "manifest_version": 3,
  "name": "Darija Translator Side Panel",
  "version": "1.0.0",
  "description": "Translate selected text into Moroccan Darija using the REST API.",
  "permissions": ["contextMenus", "sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Darija Translator"
  }
}
